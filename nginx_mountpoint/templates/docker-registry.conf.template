client_max_body_size 16G;

server {
    listen 443 ssl; # For IPv4 addresses
    listen [::]:443 ssl; # For IPv6 addresses
    ssl_certificate       /etc/nginx/certs/docker.omicsdm.cnag.dev.pem;
    ssl_certificate_key   /etc/nginx/certs/docker.omicsdm.cnag.dev-key.pem;

    #listen 80;
    access_log  /var/log/nginx/docker-registry.access.log;
    error_log  /var/log/nginx/docker-registry.error.log;
    
    server_name docker.omicsdm.cnag.dev;

    location /v2/ {
        proxy_pass http://docker-registry:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
